generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  fullName         String
  phone            String         @unique
  pinHash          String
  role             Role           @default(CASHIER)
  isActive         Boolean        @default(true)
  canRefund        Boolean        @default(false)
  canOverridePrice Boolean        @default(false)
  canViewReports   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  creditLogs       CreditLedger[]
  sales            Sale[]
  shifts           Shift[]
}

model Product {
  id            String          @id @default(uuid())
  sku           String          @unique
  name          String
  category      String
  unitPrice     Decimal         @db.Decimal(12, 2)
  costPrice     Decimal         @db.Decimal(12, 2)
  stockQty      Int             @default(0)
  lowStockAlert Int             @default(5)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  inventories   Inventory[]     @relation("ProductInventory")
  saleItems     SaleItem[]
  transfers     StockTransfer[] @relation("ProductTransfers")
}

model SaleItem {
  id         String  @id @default(uuid())
  saleId     String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  product    Product @relation(fields: [productId], references: [id])
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id           String   @id @default(uuid())
  customerId   String
  saleId       String?  @unique
  recordedById String
  amountOwed   Decimal  @db.Decimal(12, 2)
  notes        String?
  isSettled    Boolean  @default(false)
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id])
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  sale         Sale?    @relation(fields: [saleId], references: [id])
}

model Customer {
  id              String         @id @default(uuid())
  fullName        String
  phone           String         @unique
  totalCredit     Decimal        @default(0.00) @db.Decimal(12, 2)
  loyaltyPoints   Int            @default(0)
  telegramChatId  String?        @unique // 👈 Safely added for auto-linking Telegram receipts
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  creditLogs      CreditLedger[]
  sales           Sale[]
}

model Sale {
  id                  String        @id @default(uuid())
  receiptNo           String        @unique
  fiscalReceiptNumber String?
  cashierId           String
  customerId          String?
  terminalId          String?       @default("POS-1")
  paymentMethod       String
  subTotal            Decimal       @db.Decimal(12, 2)
  tax                 Decimal       @default(0.00) @db.Decimal(12, 2)
  grandTotal          Decimal       @db.Decimal(12, 2)
  status              String        @default("PAID")
  shiftId             String?
  branchId            String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt
  creditLog           CreditLedger?
  branch              Branch?       @relation("BranchSales", fields: [branchId], references: [id])
  cashier             User          @relation(fields: [cashierId], references: [id])
  customer            Customer?     @relation(fields: [customerId], references: [id])
  shift               Shift?        @relation(fields: [shiftId], references: [id])
  items               SaleItem[]
}

model Shift {
  id            String    @id @default(uuid())
  userId        String
  terminalId    String    @default("POS-1")
  openingFloat  Decimal   @default(0.00) @db.Decimal(12, 2)
  closingCash   Decimal?  @db.Decimal(12, 2)
  expectedCash  Decimal?  @db.Decimal(12, 2)
  totalTelebirr Decimal   @default(0.00) @db.Decimal(12, 2)
  totalCredit   Decimal   @default(0.00) @db.Decimal(12, 2)
  totalSales    Decimal   @default(0.00) @db.Decimal(12, 2)
  discrepancy   Decimal?  @db.Decimal(12, 2)
  status        String    @default("OPEN")
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  sales         Sale[]
  user          User      @relation(fields: [userId], references: [id])
}

model Branch {
  id                String          @id @default(uuid())
  name              String          @unique
  location          String?
  isWarehouse       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
  inventories       Inventory[]     @relation("BranchInventory")
  sales             Sale[]          @relation("BranchSales")
  incomingTransfers StockTransfer[] @relation("DestinationBranch")
  outgoingTransfers StockTransfer[] @relation("SourceBranch")
}

model Inventory {
  id        String   @id @default(uuid())
  productId String
  branchId  String
  stockQty  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  branch    Branch   @relation("BranchInventory", fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation("ProductInventory", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
}

model StockTransfer {
  id            String   @id @default(uuid())
  sourceId      String
  destId        String
  productId     String
  quantity      Int
  status        String   @default("COMPLETED")
  initiatedById String?
  notes         String?
  createdAt     DateTime @default(now())
  destBranch    Branch   @relation("DestinationBranch", fields: [destId], references: [id])
  product       Product  @relation("ProductTransfers", fields: [productId], references: [id])
  sourceBranch  Branch   @relation("SourceBranch", fields: [sourceId], references: [id])
}

enum Role {
  ADMIN
  CASHIER
}

enum PaymentMethod {
  CASH
  TELEBIRR
  BANK_TRANSFER
  CREDIT
}

enum TransactionStatus {
  PENDING
  PAID
  PARTIAL
  CANCELLED
}
